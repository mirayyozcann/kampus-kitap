generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  listings     Listing[]
}

model Listing {
  id          Int      @id @default(autoincrement())
  title       String
  course      String
  department  String
  price       Int
  condition   String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  seller      User     @relation(fields: [sellerId], references: [id])
  sellerId    Int
}